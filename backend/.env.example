# FreshTrack Backend Environment Configuration
APP_NAME=FreshTrack API
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# SQLite Database
DATABASE_URL=sqlite:///./app/database/freshtrack.db

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5555,http://127.0.0.1:5555,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5000

# File Paths (relative to backend folder)
ORIGINAL_DATA_PATH=data/original/Dataset.csv
PROCESSED_DATA_PATH=data/processed/freshtrack_cleaned.csv
SAVED_MODEL_DIR=ml/saved_model
REPORTS_DIR=reports
